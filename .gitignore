# Worktrees
.worktrees/

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Playwright artifacts (downloads, snapshots, console logs)
.playwright-mcp/

# Local secrets / env files
.env
.env.*
*.p8
*.p12
*.mobileprovision
docs/testing/mutation-report.jsonl
Scripts/__pycache__/

# Mutation-gate resume ledgers. NEVER commit one: a later run replays its verdicts
# instead of measuring them, which silently launders a previous run (or a delegate) into
# what reads as a fresh independent result.
docs/testing/*.jsonl

# SQLite sidecars for the migration fixture. Verified unnecessary: the suite passes with the
# .store alone (its WAL is checkpointed to 0 bytes), and a stale -shm can confuse SQLite.
SpeedReadTests/Fixtures/*.store-shm
SpeedReadTests/Fixtures/*.store-wal
